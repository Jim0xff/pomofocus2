{
  "name": "pomofocus2-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1 scaffold and infrastructure bootstrap for the Pomofocus2 backend GraphQL service.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:smoke": "node --experimental-strip-types --test tests/scaffold.node.test.cjs",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check ."
  },
  "dependencies": {
    "apollo-server-express": "^3.13.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "graphql": "^16.9.0",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
